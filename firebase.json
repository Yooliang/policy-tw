{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/election/2022-11-26_local", "destination": "/election/2022", "type": 301 },
      { "source": "/election/2022-11-26_local/:rest*", "destination": "/election/2022/:rest*", "type": 301 },
      { "source": "/election/2024-01-13_national", "destination": "/election/2024", "type": 301 },
      { "source": "/election/2024-01-13_national/:rest*", "destination": "/election/2024/:rest*", "type": 301 },
      { "source": "/election/2026-11-28_local", "destination": "/election/2026", "type": 301 },
      { "source": "/election/2026-11-28_local/:rest*", "destination": "/election/2026/:rest*", "type": 301 }
    ],
    "rewrites": [
      { "source": "/contributions", "destination": "/app.html" },
      { "source": "/tasks", "destination": "/app.html" },
      { "source": "/queue", "destination": "/app.html" },
      { "source": "/stats", "destination": "/app.html" },
      { "source": "/ai", "destination": "/app.html" },
      { "source": "/verify", "destination": "/app.html" },
      { "source": "/profile", "destination": "/app.html" },
      { "source": "/auth/callback", "destination": "/app.html" },
      { "source": "/election-2026", "destination": "/app.html" },
      { "source": "/admin/**", "destination": "/app.html" },
      { "source": "/policy/**", "destination": "/app.html" },
      { "source": "/lineage/**", "destination": "/app.html" },
      { "source": "/politician/**", "destination": "/app.html" },
      { "source": "/politicians/**", "destination": "/app.html" },
      { "source": "/party/**", "destination": "/app.html" },
      { "source": "/analysis/**", "destination": "/app.html" },
      { "source": "/community/**", "destination": "/app.html" },
      { "source": "/election/*/*", "destination": "/app.html" },
      { "source": "/election/*/_r/*/*", "destination": "/app.html" },
      { "regex": "^/election/[^/]+/[^/_][^/]*/[^/]+/?$", "destination": "/app.html" }
    ]
  }
}
